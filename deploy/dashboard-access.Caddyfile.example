radarr.example.com {
 header Referrer-Policy no-referrer
 header Cache-Control no-store
 @crossOrigin expression `{http.request.header.Origin} != "" && {http.request.header.Origin} != "https://radarr.example.com"`
 handle @crossOrigin {
  respond "Forbidden" 403
 }
 handle /access/REPLACE_WITH_RANDOM_SECRET {
  header Set-Cookie "__Host-media_access=REPLACE_WITH_RANDOM_SECRET; Path=/; Secure; HttpOnly; SameSite=Lax; Max-Age=2592000"
  redir / 303
 }
 @authorized expression `{http.request.cookie.__Host-media_access} == "REPLACE_WITH_RANDOM_SECRET"`
 handle @authorized {
  reverse_proxy media-stack-radarr-1:7878
 }
 handle {
  respond "Use your private dashboard link." 403
 }
}
